{
    "name": "kampus/lapor-aspirasi",
    "description": "Sistem Layanan Pengaduan Masyarakat dan Mahasiswa (Lapor/Aspirasi) berbasis CodeIgniter 4",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5",
        "phpoffice/phpspreadsheet": "^2.1",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": [
            "bash admin/setup"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
